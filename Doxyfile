# Minimal Doxygen config for TAMU_Truss. Any setting not listed here falls
# back to Doxygen's built-in default. Regenerate a full template with
# `doxygen -g` if you need to see every available option.

PROJECT_NAME           = "TAMU_Truss"
PROJECT_BRIEF          = "2D truss FEM solver (direct stiffness method)"
OUTPUT_DIRECTORY       = doxygen-build

INPUT                  = include src README.md
USE_MDFILE_AS_MAINPAGE = README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp *.md

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

WARN_IF_UNDOCUMENTED   = YES
QUIET                  = YES
