{"nodes": [{"id": "readme_tamu_truss", "label": "TAMU_Truss (Project)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_truss_solver", "label": "truss_solver (CLI executable)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_direct_stiffness_method", "label": "Direct Stiffness Method (FEM approach)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as the core solution method for the 2D truss FEM solver; it is the standard, well-understood approach for linear truss/frame analysis, keeping the implementation tractable without external FEM libraries."}, {"id": "readme_gaussian_elimination", "label": "Hand-rolled Gaussian Elimination", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implemented by hand instead of relying on an external linear algebra library ('No external deps'), trading potential performance/robustness of a mature library for zero external dependencies and full control over the solve step."}, {"id": "readme_load_ramping", "label": "Load Ramping over N Load Steps", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applied loads are ramped from 0 to full value across N steps (configured via *LOAD_STEPS) rather than applied instantaneously, so a VTK snapshot per step is produced, enabling visualization of the structure's progressive response/deformation in ParaView."}, {"id": "readme_vtk_output_format", "label": "VTK Output (Legacy ASCII per load step)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_input_format", "label": "Truss Input File Format (*NODES/*ELEMENTS/*BOUNDARIES/*FORCES/*LOAD_STEPS)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_paraview", "label": "ParaView", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_truss_solver", "target": "readme_direct_stiffness_method", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_truss_solver", "target": "readme_gaussian_elimination", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_truss_solver", "target": "readme_load_ramping", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_truss_solver", "target": "readme_vtk_output_format", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_load_ramping", "target": "readme_vtk_output_format", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_vtk_output_format", "target": "readme_paraview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_tr