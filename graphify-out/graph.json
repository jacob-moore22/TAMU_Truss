    {
      "label": "Direct Stiffness Method (FEM approach)",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Chosen as the core solution method for the 2D truss FEM solver; it is the standard, well-understood approach for linear truss/frame analysis, keeping the implementation tractable without external FEM libraries.",
      "id": "readme_direct_stiffness_method",
      "community": 2,
      "norm_label": "direct stiffness method (fem approach)"
    },
    {
      "label": "Hand-rolled Gaussian Elimination",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Implemented by hand instead of relying on an external linear algebra library ('No external deps'), trading potential performance/robustness of a mature library for zero external dependencies and full control over the solve step.",
      "id": "readme_gaussian_elimination",
      "community": 2,
      "norm_label": "hand-rolled gaussian elimination"
    },
    {
      "label": "Load Ramping over N Load Steps",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Applied loads are ramped from 0 to full value across N steps (configured via *LOAD_STEPS) rather than applied instantaneously, so a VTK snapshot per step is produced, enabling visualization of the structure's progressive response/deformation in ParaView.",
      "id": "readme_load_ramping",
      "community": 2,
      "norm_label": "load ramping over n load steps"
    },
